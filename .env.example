# Salin file ini menjadi .env untuk pengembangan lokal.
# JANGAN PERNAH commit file .env berisi nilai asli.

# --- Database (PostgreSQL 16) ---
# Untuk runtime aplikasi (bisa pooled, mis. lewat PgBouncer Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/retail_audit?schema=public"
# Untuk menjalankan migrasi Prisma (koneksi langsung, tanpa pooler)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/retail_audit?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
NEXTAUTH_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# --- Seed akun Master Researcher pertama ---
SEED_MASTER_USERNAME="master"
SEED_MASTER_PASSWORD="GantiPasswordIni123!"
SEED_MASTER_FULLNAME="Master Researcher"

# --- Umum ---
TZ="Asia/Jakarta"
NODE_ENV="development"

# --- Observability (opsional) ---
SENTRY_DSN=""
